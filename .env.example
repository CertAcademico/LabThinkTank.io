# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# 1. Go to https://one.dash.cloudflare.com → Networks → Tunnels → Create a tunnel
# 2. Choose "Cloudflared" as connector type
# 3. Copy the tunnel token and paste it here
# 4. In the tunnel config set the Public Hostname to point to:
#    Service: http://frontend:80  (the Docker service name)
CLOUDFLARE_TUNNEL_TOKEN=your_token_here

# ── API URL ───────────────────────────────────────────────────────────────────
# The URL students' browsers will use to reach the FastAPI backend.
# When using Cloudflare Tunnel, set this to your public domain.
# Example: https://cti-api.yourdomain.com
VITE_API_URL=http://localhost:8000

# ── Ollama ────────────────────────────────────────────────────────────────────
# Where the Ollama service runs (default: host machine)
OLLAMA_URL=http://host.docker.internal:11434

# ── AI Chat ───────────────────────────────────────────────────────────────────
# Claude API key — enables the AI chat panel (falls back to Ollama if not set)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Threat Intel APIs ─────────────────────────────────────────────────────────
# Optional — enrichment works without them but results will be partial.
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_vt_key_here
# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_key_here
# Shodan: https://account.shodan.io/
SHODAN_API_KEY=your_shodan_key_here
